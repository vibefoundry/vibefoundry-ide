# Plain-script PWA — no Vite, no npm, no bundler.
# All directories below are regeneratable by prepare_dev_assets.py
# or by build_app_package.py.

# Old Vite leftovers (in case anyone still has them locally).
app_core/node_modules/
app_core/dist/

# UMD libs downloaded by prepare_dev_assets.py (React, ReactDOM,
# Leaflet, Supercluster, DuckDB-WASM worker + .wasm).
app_core/src_app/lib/
# Exception: the DuckDB-WASM IIFE bundle is pre-built (DuckDB-WASM
# itself doesn't ship UMD/IIFE on unpkg, only ESM/CJS). It's
# regenerated by anyone with esbuild via:
#   echo "import * as d from '@duckdb/duckdb-wasm'; window.duckdb = d;" \
#     | npx esbuild --bundle --format=iife --target=es2020 \
#     > duckdb-bundle.js
!app_core/src_app/lib/duckdb-bundle.js

# Staged dataset — sourced from input_folder/ or sample_data/ at run time.
app_core/src_app/data/*.parquet

# TIGER reference boundaries — large, kept out of git history.
# These need to be downloaded separately (one-time, hosted externally).
app_core/src_app/data/boundaries/

# Pre-existing Vite layout's data/lib paths — keep ignored in case any
# user has them locally from before the migration.
app_core/src_app/public/lib/
app_core/src_app/public/data/*.parquet
app_core/src_app/public/data/boundaries/
